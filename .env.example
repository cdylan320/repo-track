DISCORD_WEBHOOK_URL=
DEST_GITHUB_TOKEN=
DEST_GITHUB_ACCOUNT=
# Optional: rotate dest API/push tokens (comma-separated, same account)
# DEST_GITHUB_TOKENS=ghp_aaa,ghp_bbb
# Optional: one poll token per origin (round-robin by account order)
# POLL_TOKENS=ghp_one,ghp_two,ghp_three
# Optional: explicit origin → token map (overrides POLL_TOKENS slot)
# POLL_TOKEN_MAP=asura625:ghp_xxx,alche3206:ghp_yyy
# Optional: read private origin repos
# GITHUB_TOKEN=
POLL_INTERVAL_SECONDS=15
HOST=0.0.0.0
PORT=6001
